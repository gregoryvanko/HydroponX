    {
        "id": "ce3d6f9cd1486a52",
        "type": "function",
        "z": "41c985e7d9b48edd",
        "name": "Prépare télégramme mesg",
        "func": "if(msg.payload == 0){\n   msg.payload = \"Flux d'eau arreté\" \n} else if (msg.payload == 1){\n   msg.payload = \"Flux d'eau détecté\"\n} else if (msg.payload == 2) {\n   msg.payload = \"Delais écoulé entre deux message WaterPresent\"\n} else {\n   msg.payload = \"Statut WaterPresent non connu : \" + msg.payload\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 180,
