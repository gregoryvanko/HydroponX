    {
        "id": "912ecccdc86d1924",
        "type": "function",
        "z": "41c985e7d9b48edd",
        "name": "Update saved data",
        "func": "let Name = \"PresenceEau1\"\n// recupérer la precedente valeur sauvée\nlet SavedData = global.get(Name) || null\n// sauver la nouvelle valeur\nlet NewData = { time: new Date().getTime(), data: msg.payload }\nglobal.set(Name, NewData)\n\nif (SavedData != null) {\n    let value = SavedData.data\n    if (value != msg.payload) {\n        // on ne communique le msg que si la valeur précédente est différent da la nouvelle valeur\n        return msg\n    }\n} else {\n    return msg\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 180,
        "wires": [
            [
                "ce3d6f9cd1486a52"
            ]
        ]
    },
    {
        "id": "a0a2920f16a776d2",
        "type": "function",
        "z": "41c985e7d9b48edd",
        "g": "311d0db22d11f271",
        "name": "Delta time",
        "func": "let time = msg.payload\nlet Name = \"PresenceEau1\"\n\nlet AllData = global.get(Name) || null\nif (AllData != null){\n    let delta = (time - AllData.time) / 1000\n    let rounddelta = Math.round(delta)\n    if (rounddelta > 60) { \n        msg.payload = 2;\n        return msg;\n    }\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 340,
        "wires": [
            [
                "748196d233ab6447",
                "912ecccdc86d1924"
            ]
        ]
    },
